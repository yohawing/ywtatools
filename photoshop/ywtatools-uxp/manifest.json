{
  "manifestVersion": 5,
  "id": "com.yohaw.ywtatools",
  "name": "YWTA Tools",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ywtaToolsPanel",
      "label": {
        "default": "YWTA Tools"
      },
      "minimumSize": {
        "width": 240,
        "height": 160
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 320
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 360
      }
    }
  ]
}

